{
  "name": "inventory-platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory Management Platform - POS integration backend (Square + Toast)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node api.js && nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node api.js && node dist/index.js",
    "seed": "ts-node src/seed/seed.ts",
    "square:test-sale": "ts-node scripts/square-test-sale.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "square": "^38.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
